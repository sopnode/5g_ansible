# rnti-mapper: exports ran_ue_info{rnti,ran_ue_id,imsi,ue_name} 1 for Grafana joins on rnti.
# Separate pod, nothing runs in the gNB container. kubectl comes from the node (hostPath).
apiVersion: v1
kind: ConfigMap
metadata:
  name: rnti-mapper
  namespace: {{ rnti_mapper_namespace }}
data:
  # IMSI -> UE name, generated from the 'ues' of the 5G profile. Unknown IMSIs are shown as the IMSI.
  ue_names: |
    # IMSI            name
{% for name, ue in (fiveg.ues | default({})).items() %}
    {{ fiveg.plmn.mcc }}{{ fiveg.plmn.mnc }}{{ ue.imsi_suffix }}   {{ name }}
{% endfor %}
  join.awk: |
{{ lookup('ansible.builtin.file', 'join.awk') | indent(4, true) }}
  run.sh: |
{{ lookup('ansible.builtin.file', 'run.sh') | indent(4, true) }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: rnti-mapper
  namespace: {{ rnti_mapper_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: rnti-mapper
  namespace: {{ rnti_mapper_namespace }}
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list"]
  - apiGroups: [""]
    resources: ["pods/log"]
    verbs: ["get"]
  - apiGroups: [""]
    resources: ["pods/exec"]
    verbs: ["create", "get"]
  - apiGroups: ["apps"]
    resources: ["deployments", "replicasets"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: rnti-mapper
  namespace: {{ rnti_mapper_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: rnti-mapper
subjects:
  - kind: ServiceAccount
    name: rnti-mapper
    namespace: {{ rnti_mapper_namespace }}
{% if rnti_mapper_core_namespace != rnti_mapper_namespace %}
---
# read access to the AMF logs in the core namespace
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: rnti-mapper
  namespace: {{ rnti_mapper_core_namespace }}
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list"]
  - apiGroups: [""]
    resources: ["pods/log"]
    verbs: ["get"]
  - apiGroups: ["apps"]
    resources: ["deployments", "replicasets"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: rnti-mapper
  namespace: {{ rnti_mapper_core_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: rnti-mapper
subjects:
  - kind: ServiceAccount
    name: rnti-mapper
    namespace: {{ rnti_mapper_namespace }}
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: rnti-mapper
  namespace: {{ rnti_mapper_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: rnti-mapper
  template:
    metadata:
      labels:
        app: rnti-mapper
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/path: "/metrics"
        prometheus.io/port: "{{ rnti_mapper_port }}"
    spec:
      serviceAccountName: rnti-mapper
      # the control-plane node has a static kubectl at the hostPath below (and is not the RAN node)
      nodeSelector:
        node-role.kubernetes.io/control-plane: ""
      containers:
        - name: rnti-mapper
          image: {{ rnti_mapper_image }}
          command: ["/bin/sh", "/rnti-mapper/run.sh"]
          env:
            - {name: PORT, value: "{{ rnti_mapper_port }}"}
            - {name: PERIOD, value: "{{ rnti_mapper_period }}"}
            - {name: NS, value: "{{ rnti_mapper_namespace }}"}
            # RAN file read from a sidecar sharing the gNB log volume (see defaults)
            - {name: RAN_DEPLOY, value: "{{ rnti_mapper_ran_deploy }}"}
            - {name: RAN_SOURCES, value: "{{ rnti_mapper_ran_sources | trim }}"}
            - {name: RAN_PATTERN, value: "{{ rnti_mapper_ran_pattern }}"}
            - {name: RAN_TYPE, value: "{{ rnti_mapper_ran_type }}"}
            - {name: CORE_NS, value: "{{ rnti_mapper_core_namespace }}"}
            - {name: CORE_TYPE, value: "{{ rnti_mapper_core_type }}"}
            - {name: PLMN, value: "{{ fiveg.plmn.mcc }}{{ fiveg.plmn.mnc }}"}
            # DNN -> snssai label of slice_throughput (sst, or sst-sd when the slice has an SD)
            - name: DNN_SNSSAI
              value: "{% for sl in fiveg.slices | default([]) %}{{ sl.dnn }}={{ sl.sst | int }}{% if (sl.sd | default('EMPTY') | string | upper) not in ['EMPTY', '', 'FFFFFF'] %}-{{ sl.sd }}{% endif %} {% endfor %}"
            - {name: INVENTORY_URL, value: "{{ rnti_mapper_inventory_url | trim }}"}
            - {name: AMF_DEPLOY, value: "{{ rnti_mapper_amf_deploy }}"}
            - {name: AMF_CONTAINER, value: "{{ rnti_mapper_amf_container }}"}
            - {name: AMF_TAIL, value: "{{ rnti_mapper_amf_tail }}"}
          ports:
            - {containerPort: {{ rnti_mapper_port }}, name: metrics}
          volumeMounts:
            - {name: rnti-mapper-files, mountPath: /rnti-mapper}
            - {name: kubectl, mountPath: /bin/kubectl, readOnly: true}
          resources:
            requests: {cpu: "50m", memory: "32Mi"}
            limits: {cpu: "200m", memory: "64Mi"}
      volumes:
        - name: rnti-mapper-files
          configMap:
            name: rnti-mapper
        - name: kubectl
          hostPath:
            path: {{ rnti_mapper_kubectl_path }}
            type: File
